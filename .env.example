# ============================================================
# AI Skill 编排系统 — 环境变量配置
# 使用方法：复制此文件为 .env 并修改对应值
#   cp .env.example .env
# ============================================================

# ---------- FTP 存储配置 ----------
FTP_USER=admin
FTP_PASS=admin

# FTP 被动模式地址（填入宿主机 IP，容器间通信可保持默认）
# 外部 FTP 客户端连接时需要此 IP 才能建立被动数据连接
PASV_ADDRESS=0.0.0.0
PASV_MIN_PORT=20000
PASV_MAX_PORT=20000

# ---------- AI 模型配置 ----------
# 支持 OpenAI 兼容 API（默认使用阿里通义千问 DashScope）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=your-api-key-here
AI_MODEL=qwen3.7-max-2026-05-17
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=16384
AI_TIMEOUT=300000
